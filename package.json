{
  "name": "panda-care",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/run.mjs dev all",
    "dev:ranveer": "node scripts/run.mjs dev panda",
    "dev:asmita": "node scripts/run.mjs dev care",
    "dev:yuvraj": "node scripts/run.mjs dev rehab",
    "build": "node scripts/run.mjs build all",
    "start": "node scripts/run.mjs start all",
    "typecheck": "tsc -p apps/panda && tsc -p apps/care && tsc -p apps/rehab && tsc -p tsconfig.tests.json",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm test",
    "test:integration": "node scripts/integration.mjs",
    "test:providers:live": "node --import tsx scripts/provider-smoke.mjs",
    "voice:purge": "node --import tsx scripts/voice-purge.mjs",
    "seed:demo": "node scripts/generate-demo-patients.mjs",
    "doctor": "node scripts/doctor.mjs",
    "start:production": "node --import tsx scripts/production/start.mjs",
    "db:migrate": "node --import tsx scripts/production/migrate.mjs",
    "account:grant": "node --import tsx scripts/production/grant.mjs",
    "cv:assets": "node scripts/cv-assets.mjs",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
