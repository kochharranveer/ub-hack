# Public HAPI FHIR R4 test server. Use synthetic data only.
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
FHIR_PATIENT_ID=patient-t1
# Optional bearer token for servers that require it. Keep real secrets in .env.local.
FHIR_ACCESS_TOKEN=
# Care plan generation uses Gemini; set a server-side key and an available model ID.
CARE_GEMINI_API_KEY=
CARE_GEMINI_MODEL=gemini-3.5-flash
